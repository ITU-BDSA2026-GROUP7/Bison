@page "/obs/{author}"
@model Bison.Razor.Pages.UserTimelineModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("author");
}

<div>
    @if (TempData["VoteError"] is string voteError)
    {
        <div class="error" role="alert">@voteError</div>
    }

    @if (Model.IsOwnTimeline)
    {
        <h2> My Observations </h2>

        <div class="observationbox">
            <h3>What did you see, @(User.Identity?.Name)?</h3>
            <form method="post" enctype="multipart/form-data">
                <p>
                    <label asp-for="ObservedTaxonId">Taxon:</label>
                    <select asp-for="ObservedTaxonId">
                        <option value="">Don't know</option>
                        @foreach (var taxon in Model.NamedTaxa)
                        {
                            <option value="@taxon.DwcTaxonId">@taxon.DanishVernacularName</option>
                        }
                    </select>
                </p>
                <input style="float: left" type="text" asp-for="Text" aria-label="What did you see?">
                <p>
                    <label asp-for="Picture">Picture (JPEG, PNG, GIF, or WebP; up to 5 MB):</label>
                    <input type="file" asp-for="Picture" accept="image/jpeg,image/png,image/gif,image/webp">
                </p>
                <p>             
                    <partial name="_LicenseSelect" model="Model.PictureLicense" />
                </p>
                <input type="submit" value="Share">
            </form>
            <span asp-validation-for="Text"></span>
            <span asp-validation-for="ObservedTaxonId"></span>
            <span asp-validation-for="Picture"></span>
            <span asp-validation-for="PictureLicense"></span>
        </div>
    }
    else
    {
        <h2> @routeName's Observations </h2>
    }

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var ob in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@ob.Author">@ob.Author</a>
                        </strong>
                        <a href="/ob/@ob.Id">@ob.Message</a>
                        <small>&mdash; @ob.Timestamp</small>
                    </p>
                    @if (!string.IsNullOrEmpty(ob.PicturePath))
                    {
                        <img class="observation-picture" src="@ob.PicturePath"
                            alt="Picture of the animal in the observation by @ob.Author" />
                        <partial name="_PictureLicense" model="ob.PictureLicense" />
                    }
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form method="post" asp-page-handler="Vote" class="vote-controls">
                            <input type="hidden" name="postId" value="@ob.Id" />
                            <input type="hidden" name="page" value="@Model.CurrentPage" />
                            <button type="submit" name="direction" value="true">Upvote (@ob.UpVotes)</button>
                            <button type="submit" name="direction" value="false">Downvote (@ob.DownVotes)</button>
                        </form>
                    }
                    else
                    {
                        <p class="vote-counts">Upvotes: @ob.UpVotes | Downvotes: @ob.DownVotes</p>
                    }
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no Observations so far.</em>
    }
    <div>
    @if (Model.CurrentPage > 1)
    {
        <a href="/obs/@routeName?page=@(Model.CurrentPage - 1)">
            Previous
        </a>
    }

    <span> Page @Model.CurrentPage </span>

    @if (Model.HasNextPage)
    {
        <a href="/obs/@routeName?page=@(Model.CurrentPage + 1)">
            Next
        </a>
    }
    </div>
</div>
