@page "/obs/{author}"
@model Bison.Razor.Pages.UserTimelineModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("author");
}

<div>
    @if (Model.IsOwnTimeline)
    {
        <h2> My Observations </h2>

        <div class="observationbox">
            <h3>What did you see, @(User.Identity?.Name)?</h3>
            <form method="post">
                <p>
                    <label asp-for="ObservedTaxonId">Taxon:</label>
                    <select asp-for="ObservedTaxonId">
                        <option value="">Don't know</option>
                        @foreach (var taxon in Model.NamedTaxa)
                        {
                            <option value="@taxon.DwcTaxonId">@taxon.DanishVernacularName</option>
                        }
                    </select>
                </p>
                <input style="float: left" type="text" asp-for="Text">
                <input type="submit" value="Share">
            </form>
            <span asp-validation-for="Text"></span>
            <span asp-validation-for="ObservedTaxonId"></span>
        </div>
    }
    else
    {
        <h2> @routeName's Observations </h2>
    }

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var ob in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@ob.Author">@ob.Author</a>
                        </strong>
                        <a href="/ob/@ob.Id">@ob.Message</a>
                        <small>&mdash; @ob.Timestamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no Observations so far.</em>
    }
    <div>
    @if (Model.CurrentPage > 1)
    {
        <a href="/obs/@routeName?page=@(Model.CurrentPage - 1)">
            Previous
        </a>
    }

    <span> Page @Model.CurrentPage </span>

    @if (Model.HasNextPage)
    {
        <a href="/obs/@routeName?page=@(Model.CurrentPage + 1)">
            Next
        </a>
    }
    </div>
</div>
