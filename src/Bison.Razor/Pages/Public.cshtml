@page "/obs"
@model Bison.Razor.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    <h2> Public Timeline </h2>

    <form method="get" action="/obs">
        <label for="taxonId">Filter by taxon:</label>

        <select id="taxonId" name="taxonId">
            <option value="">All taxa</option>

            @foreach (var taxon in Model.Taxa)
           {
                if (taxon.DwcTaxonId == Model.SelectedTaxonId)
                {
                    <option value="@taxon.DwcTaxonId" selected>
                        @taxon.DanishVernacularName
                    </option>
                }
                else
                {
                    <option value="@taxon.DwcTaxonId">
                        @taxon.DanishVernacularName
                       </option>
                }
            }
        </select>

        <button type="submit">Filter</button>
    </form>


    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@obs.Author">@obs.Author</a>
                        </strong>
                        <a href="/ob/@obs.Id">@obs.Message</a>
                        <small>&mdash; @obs.Timestamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }
    <div>
    @if (Model.CurrentPage > 1)
    {
        <a href="/obs?page=@(Model.CurrentPage - 1)&taxonId=@Uri.EscapeDataString(Model.SelectedTaxonId ?? string.Empty)">
            Previous
        </a>
    }

    <span> Page @Model.CurrentPage </span>

    @if (Model.HasNextPage)
    {
        <a href="/obs?page=@(Model.CurrentPage + 1)&taxonId=@Uri.EscapeDataString(Model.SelectedTaxonId ?? string.Empty)">
            Next
        </a>
    }
    </div>
</div>
