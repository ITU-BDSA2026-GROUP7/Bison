@page "/obs"
@model Bison.Razor.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    <h2> Public Observations </h2>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="observationbox">
            <h3>What did you see, @(User.Identity?.Name)?</h3>
            <form method="post" enctype="multipart/form-data">
                <p>
                    <label asp-for="ObservedTaxonId">Taxon:</label>
                    <select asp-for="ObservedTaxonId">
                        <option value="">Don't know</option>
                        @foreach (var taxon in Model.NamedTaxa)
                        {
                            <option value="@taxon.DwcTaxonId">@taxon.DanishVernacularName</option>
                        }
                    </select>
                </p>
                <input style="float: left" type="text" asp-for="Text" aria-label="What did you see?">
                <p>
                    <label asp-for="Picture">Picture (JPEG, PNG, GIF, or WebP; up to 5 MB):</label>
                    <input type="file" asp-for="Picture" accept="image/jpeg,image/png,image/gif,image/webp">
                </p>
                <input type="submit" value="Share">
            </form>
            <span asp-validation-for="Text"></span>
            <span asp-validation-for="ObservedTaxonId"></span>
            <span asp-validation-for="Picture"></span>
        </div>
    }

    <form method="get" action="/obs">
        <label for="taxonId">Filter by taxon:</label>

        <select id="taxonId" name="taxonId">
            <option value="">All taxa</option>

            @foreach (var taxon in Model.Taxa)
           {
                if (taxon.DwcTaxonId == Model.SelectedTaxonId)
                {
                    <option value="@taxon.DwcTaxonId" selected>
                        @taxon.DanishVernacularName
                    </option>
                }
                else
                {
                    <option value="@taxon.DwcTaxonId">
                        @taxon.DanishVernacularName
                       </option>
                }
            }
        </select>

        <button type="submit">Filter</button>
    </form>


    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@obs.Author">@obs.Author</a>
                        </strong>
                        <a href="/ob/@obs.Id">@obs.Message</a>
                        <small>&mdash; @obs.Timestamp</small>
                    </p>
                    @if (!string.IsNullOrEmpty(obs.PicturePath))
                    {
                        <img class="observation-picture" src="@obs.PicturePath"
                            alt="Picture of the animal in the observation by @obs.Author" />
                    }
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form method="post" asp-page-handler="Vote" class="vote-controls">
                            <input type="hidden" name="postId" value="@obs.Id" />
                            <input type="hidden" name="page" value="@Model.CurrentPage" />
                            <input type="hidden" name="taxonId" value="@Model.SelectedTaxonId" />
                            <button type="submit" name="direction" value="true">Upvote (@obs.UpVotes)</button>
                            <button type="submit" name="direction" value="false">Downvote (@obs.DownVotes)</button>
                        </form>
                    }
                    else
                    {
                        <p class="vote-counts">Upvotes: @obs.UpVotes | Downvotes: @obs.DownVotes</p>
                    }
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }
    <div>
    @if (Model.CurrentPage > 1)
    {
        <a href="/obs?page=@(Model.CurrentPage - 1)&taxonId=@Uri.EscapeDataString(Model.SelectedTaxonId ?? string.Empty)">
            Previous
        </a>
    }

    <span> Page @Model.CurrentPage </span>

    @if (Model.HasNextPage)
    {
        <a href="/obs?page=@(Model.CurrentPage + 1)&taxonId=@Uri.EscapeDataString(Model.SelectedTaxonId ?? string.Empty)">
            Next
        </a>
    }
    </div>
</div>
