@page "/ob/{id}"
@model Bison.Razor.Pages.ObservationDetailsModel
@{
    ViewData["Title"] = "Observation";
    Layout = "Shared/_Layout";
}

<div>
    <h2>Observation</h2>

    @if (Model.Details is not null)
    {
        <div class="observationbox">
            <p>
                <strong>
                    <a href="/obs/@Model.Details.Observation.Author">@Model.Details.Observation.Author</a>
                </strong>
                @Model.Details.Observation.Message
                <small>&mdash; @Model.Details.Observation.Timestamp</small>
            </p>
        </div>

        <h3>Comments</h3>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="observationbox">
                <form method="post" asp-page-handler="Comment">
                    <input style="float: left" type="text" asp-for="CommentText" placeholder="Write a comment, @(User.Identity?.Name)">
                    <input type="submit" value="Comment">
                </form>
                <span asp-validation-for="CommentText"></span>
            </div>
        }

        @if (Model.Details.Comments.Observations.Any())
        {
            <ul id="messagelist" class="observations">
                @foreach (var comment in Model.Details.Comments.Observations)
                {
                    <li>
                        <p>
                            <strong>@comment.Author</strong>
                            @comment.Message
                            <small>&mdash; @comment.Timestamp</small>
                        </p>
                    </li>
                }
            </ul>
        }
        else
        {
            <em>There are no comments so far.</em>
        }

        <h3>Proposals</h3>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="observationbox">
                <form method="post" asp-page-handler="Proposal">
                    <p>
                        <label asp-for="ProposedTaxonId">Taxon:</label>
                        <select asp-for="ProposedTaxonId">
                            <option value="">Choose a taxon</option>
                            @foreach (var taxon in Model.NamedTaxa)
                            {
                                <option value="@taxon.DwcTaxonId">@taxon.DanishVernacularName</option>
                            }
                        </select>
                    </p>
                    <input style="float: left" type="text" asp-for="ProposalText" placeholder="Why do you think so?">
                    <input type="submit" value="Propose">
                </form>
                <span asp-validation-for="ProposalText"></span>
                <span asp-validation-for="ProposedTaxonId"></span>
            </div>
        }
        
        @if (Model.Details.Proposals.Observations.Any())
        {
            <ul id="messagelist" class="observations">
                @foreach (var proposal in Model.Details.Proposals.Observations)
                {
                    <li>
                        <p>
                            <strong>@proposal.Author</strong>
                            @proposal.Message
                            <small>&mdash; @proposal.Timestamp</small>
                        </p>
                        <p>Taxon: @proposal.TaxonName</p>
                    </li>
                }
            </ul>
        }
        else
        {
            <em>There are no proposals so far.</em>
        }
    }
    else
    {
        <em>Observation not found.</em>
    }
</div>